# ---- NabooPay ----
# Clé API (dashboard NabooPay > Paramètres > Intégration)
NABOOPAY_API_KEY=changeme_naboopay_api_key
# Secret du webhook, sert à vérifier la signature X-Signature (HMAC SHA256)
NABOOPAY_WEBHOOK_SECRET=changeme_webhook_secret
# Base URL de l'API (par défaut la v2 publique)
NABOOPAY_BASE_URL=https://api.naboopay.com/api/v2

# ---- App ----
# URL(s) du frontend, séparées par des virgules : toutes sont autorisées en CORS,
# la PREMIÈRE sert à construire success_url / error_url (retour après paiement).
# Ex. avec Vercel : FRONTEND_URL=https://foryou.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173
PORT=3000

# ---- Dashboard d'administration ----
# URL(s) du dashboard, séparées par des virgules (CORS)
# Ex. avec Vercel : DASHBOARD_URL=https://foryou-admin.vercel.app,http://localhost:5174
DASHBOARD_URL=http://localhost:5174
# Secret de signature des sessions (32 caractères min.)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=changeme_secret_de_session_au_moins_32_caracteres
# Durée d'une session, en heures
ADMIN_SESSION_TTL_HOURS=12

# ---- Paiement ----
# Montant minimum accepté, en F CFA (entier)
MIN_AMOUNT=500
# Plafond anti-abus, en F CFA (entier)
MAX_AMOUNT=2000000
CURRENCY=XOF
# Montants proposés en un clic sur le frontend
SUGGESTED_AMOUNTS=2000,5000,10000

# ---- Base de données ----
# SQLite en local. Pour Postgres : DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
DATABASE_URL="file:./dev.db"
